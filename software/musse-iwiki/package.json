{
  "name": "musse-iwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MuSSE task/schedule/goal logic with iWiki as the only persistent source",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "mcp": "node src/mcp/server.ts",
    "mcp:readonly": "node src/mcp/server-readonly.ts",
    "inspect:readonly": "node tools/inspect-readonly.mjs",
    "probe:read-shape": "node tools/probe-read-structure.mjs",
    "probe:task-queries": "node tools/probe-task-queries.mjs",
    "probe:goal-notes": "node tools/probe-goal-notes.mjs",
    "mcp:s5": "node src/mcp/server-s5.ts",

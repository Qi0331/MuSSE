diff --git a/main/musse_display/include/musse/display/emotion_renderer.h b/main/musse_display/include/musse/display/emotion_renderer.h
new file mode 100644
index 0000000..9a03a34
--- /dev/null
+++ b/main/musse_display/include/musse/display/emotion_renderer.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdint>
+
+#include "musse/display/emotion.h"
+#include "musse/display/frame_buffer.h"
+
+namespace musse::display {
+
+/**
+ * Stateless expression renderer.
+ *
+ * The renderer only depends on the expression and an externally supplied
+ * millisecond clock. It performs no sleeping, allocation or I/O, so identical
+ * inputs always produce identical frames (deterministic for tests/preview).
+ *
+ * Animation periods (ms):
+ *   Idle      3000 (blink 160 ms at the start of each period)
+ *   Listening 1200 (sound-level bars)
+ *   Thinking  1500 (three dots, 500 ms per dot)
+ *   Speaking   250 (mouth open/close)
+ *   Error      600 (border flash)
+ */
+class EmotionRenderer {
+public:
+    FrameBuffer render(Emotion emotion, std::uint32_t timeMs) const;
+};
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/event.h b/main/musse_display/include/musse/display/event.h
new file mode 100644
index 0000000..98c81f5
--- /dev/null
+++ b/main/musse_display/include/musse/display/event.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+
+namespace musse::display {
+
+enum class EventType : std::uint8_t {
+    DeviceState = 1,
+    Emotion = 2,
+    Thinking = 3,
+    AlertEmotion = 4,
+    AlertDismiss = 5,
+    AlertProgress = 6,
+};
+
+/**
+ * Fixed-size event used by the firmware bridge and host scheduling tests.
+ * text is only used for emotion events and is always NUL-terminated.
+ * seq is assigned by the queue; producers may leave it zero.
+ */
+struct Event {
+    EventType type = EventType::DeviceState;
+    std::uint8_t value = 0;
+    std::uint32_t timeMs = 0;
+    std::uint32_t seq = 0;
+    char text[32] = {};
+};
+
+constexpr int kEventTextCapacity = 32;
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/event_dispatch.h b/main/musse_display/include/musse/display/event_dispatch.h
new file mode 100644
index 0000000..2bd9e86
--- /dev/null
+++ b/main/musse_display/include/musse/display/event_dispatch.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "musse/display/event.h"
+#include "musse/display/state_adapter.h"
+
+namespace musse::display {
+
+/**
+ * Applies one event to the adapter. Shared by the firmware render task and
+ * the host event-ordering tests, so the tested logic is the production logic.
+ */
+inline bool applyEvent(StateAdapter& adapter, const Event& event) {
+    switch (event.type) {
+        case EventType::DeviceState:
+            adapter.onDeviceState(static_cast<DeviceState>(event.value));
+            return true;
+        case EventType::Emotion:
+            return adapter.onEmotionName(event.text, event.timeMs);
+        case EventType::Thinking:
+            adapter.setThinking(event.value != 0, event.timeMs);
+            return true;
+        case EventType::AlertEmotion:
+            return adapter.onAlertEmotion(event.text, event.timeMs);
+        case EventType::AlertProgress:
+            return adapter.onAlertEmotion(event.text, event.timeMs);
+        case EventType::AlertDismiss:
+            adapter.onAlertDismissed();
+            return true;
+    }
+    return false;
+}
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/event_queue.h b/main/musse_display/include/musse/display/event_queue.h
new file mode 100644
index 0000000..2e34368
--- /dev/null
+++ b/main/musse_display/include/musse/display/event_queue.h
@@ -0,0 +1,173 @@
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+#include "musse/display/event.h"
+
+namespace musse::display {
+
+/**
+ * Bounded event queue with a protected "critical" lane.
+ *
+ * Problem being solved: a flood of ordinary emotion events must never push a
+ * critical control event (latest device state, error entry, AlertDismiss,
+ * Thinking on/off) out of the queue.
+ *
+ * Design:
+ *  - Ordinary events (Emotion, AlertProgress) go into a 16-entry FIFO ring.
+ *    When full, the OLDEST ordinary event is dropped and counted.
+ *  - Critical events go into one slot per kind (DeviceState, Thinking,
+ *    AlertEmotion, AlertDismiss). A slot always keeps the NEWEST event of its
+ *    kind (merge, counted), so it can never be overflowed by ordinary events.
+ *  - pop() returns the event with the smallest sequence number across both
+ *    lanes, so global arrival order is preserved as closely as possible.
+ *    Ties favour the critical event.
+ *
+ * Locking is a policy template:
+ *  - host tests: std::mutex (multi-producer safe, no unbounded spinning);
+ *  - firmware: portMUX critical section (short, task context only).
+ *
+ * ISR producers are NOT supported by this queue; use an ISR-safe queue or
+ * defer to a task if that is ever needed.
+ */
+template <class LockPolicy>
+class BasicEventQueue {
+public:
+    static constexpr int kEmotionCapacity = 16;
+    static constexpr int kControlSlotCount = 4;
+
+    BasicEventQueue() = default;
+    BasicEventQueue(const BasicEventQueue&) = delete;
+    BasicEventQueue& operator=(const BasicEventQueue&) = delete;
+
+    void push(const Event& event) {
+        lock_.lock();
+        Event stored = event;
+        stored.seq = nextSeq_++;
+        ++pushed_;
+
+        const int slot = controlSlot(stored.type);
+        if (slot >= 0) {
+            if (slots_[slot].occupied) {
+                ++merged_;
+            }
+            slots_[slot].event = stored;
+            slots_[slot].occupied = true;
+            lock_.unlock();
+            return;
+        }
+
+        if (emotionCount_ == kEmotionCapacity) {
+            emotionHead_ = (emotionHead_ + 1) % kEmotionCapacity;
+            --emotionCount_;
+            ++dropped_;
+        }
+        emotions_[emotionTail_] = stored;
+        emotionTail_ = (emotionTail_ + 1) % kEmotionCapacity;
+        ++emotionCount_;
+        lock_.unlock();
+    }
+
+    bool pop(Event& event) {
+        lock_.lock();
+
+        int bestSlot = -1;
+        std::uint32_t bestSeq = 0xFFFFFFFFu;
+        for (int i = 0; i < kControlSlotCount; ++i) {
+            if (slots_[i].occupied && slots_[i].event.seq < bestSeq) {
+                bestSeq = slots_[i].event.seq;
+                bestSlot = i;
+            }
+        }
+
+        // Strictly smaller: on an equal sequence, critical wins.
+        const bool emotionWins =
+            emotionCount_ > 0 && emotions_[emotionHead_].seq < bestSeq;
+
+        if (bestSlot >= 0 && !emotionWins) {
+            event = slots_[bestSlot].event;
+            slots_[bestSlot].occupied = false;
+            lock_.unlock();
+            return true;
+        }
+        if (emotionWins) {
+            event = emotions_[emotionHead_];
+            emotionHead_ = (emotionHead_ + 1) % kEmotionCapacity;
+            --emotionCount_;
+            lock_.unlock();
+            return true;
+        }
+
+        lock_.unlock();
+        return false;
+    }
+
+    int size() const {
+        lock_.lock();
+        int size = emotionCount_;
+        for (const auto& slot : slots_) {
+            if (slot.occupied) {
+                ++size;
+            }
+        }
+        lock_.unlock();
+        return size;
+    }
+
+    std::uint32_t dropped() const {
+        lock_.lock();
+        const auto value = dropped_;
+        lock_.unlock();
+        return value;
+    }
+
+    std::uint32_t merged() const {
+        lock_.lock();
+        const auto value = merged_;
+        lock_.unlock();
+        return value;
+    }
+
+    std::uint32_t pushed() const {
+        lock_.lock();
+        const auto value = pushed_;
+        lock_.unlock();
+        return value;
+    }
+
+private:
+    struct Slot {
+        Event event{};
+        bool occupied = false;
+    };
+
+    static int controlSlot(EventType type) {
+        switch (type) {
+            case EventType::DeviceState: return 0;
+            case EventType::Thinking: return 1;
+            case EventType::AlertEmotion: return 2;
+            case EventType::AlertDismiss: return 3;
+            case EventType::Emotion:
+            case EventType::AlertProgress:
+                return -1;
+        }
+        return -1;
+    }
+
+    mutable LockPolicy lock_;
+    Event emotions_[kEmotionCapacity] = {};
+    int emotionHead_ = 0;
+    int emotionTail_ = 0;
+    int emotionCount_ = 0;
+    Slot slots_[kControlSlotCount] = {};
+    std::uint32_t nextSeq_ = 1;
+    std::uint32_t dropped_ = 0;
+    std::uint32_t merged_ = 0;
+    std::uint32_t pushed_ = 0;
+};
+
+/** Host implementation: mutex-protected, no unbounded spinning. */
+using EventQueue = BasicEventQueue<std::mutex>;
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/frame_buffer.h b/main/musse_display/include/musse/display/frame_buffer.h
new file mode 100644
index 0000000..87b2779
--- /dev/null
+++ b/main/musse_display/include/musse/display/frame_buffer.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "musse/display/color.h"
+
+namespace musse::display {
+
+/**
+ * Fixed 16x16 RGB888 frame buffer.
+ *
+ * Coordinates: origin at top-left, x to the right, y downwards.
+ * Out-of-range writes are rejected (return false) and never touch memory.
+ * Out-of-range reads return black.
+ */
+class FrameBuffer {
+public:
+    static constexpr int kWidth = 16;
+    static constexpr int kHeight = 16;
+    static constexpr std::size_t kPixelCount =
+        static_cast<std::size_t>(kWidth) * static_cast<std::size_t>(kHeight);
+
+    FrameBuffer();
+
+    void clear(Rgb color = color::Black);
+
+    bool setPixel(int x, int y, Rgb color);
+    Rgb pixel(int x, int y) const;
+
+    bool fillRect(int x, int y, int width, int height, Rgb color);
+    bool drawRect(int x, int y, int width, int height, Rgb color);
+    bool drawLine(int x0, int y0, int x1, int y1, Rgb color);
+    bool fillCircle(int centerX, int centerY, int radius, Rgb color);
+
+    Rgb* data() { return pixels_; }
+    const Rgb* data() const { return pixels_; }
+
+    bool operator==(const FrameBuffer& other) const;
+    bool operator!=(const FrameBuffer& other) const { return !(*this == other); }
+
+private:
+    Rgb pixels_[kPixelCount];
+};
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/noop_sink.h b/main/musse_display/include/musse/display/noop_sink.h
new file mode 100644
index 0000000..4f9585d
--- /dev/null
+++ b/main/musse_display/include/musse/display/noop_sink.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <atomic>
+
+#include "musse/display/display_sink.h"
+
+namespace musse::display {
+
+/**
+ * Sink used when no electrically verified LED hardware is available.
+ *
+ * It only counts frames; it never touches GPIO, I2C, RMT or any hardware.
+ * The counter is atomic because the firmware render task and diagnostics may
+ * read it from different tasks.
+ */
+class NoopSink final : public DisplaySink {
+public:
+    bool drawFrame(const FrameBuffer& frame) override {
+        (void)frame;
+        frames_.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+
+    int frames() const { return frames_.load(std::memory_order_relaxed); }
+
+private:
+    std::atomic<int> frames_{0};
+};
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/pipeline.h b/main/musse_display/include/musse/display/pipeline.h
new file mode 100644
index 0000000..8489f82
--- /dev/null
+++ b/main/musse_display/include/musse/display/pipeline.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstdint>
+
+#include "musse/display/animation_controller.h"
+#include "musse/display/display_sink.h"
+#include "musse/display/emotion.h"
+#include "musse/display/state_adapter.h"
+
+namespace musse::display {
+
+/**
+ * End-to-end software pipeline:
+ *   state/emotion -> StateAdapter -> AnimationController -> EmotionRenderer
+ *   -> DisplaySink
+ *
+ * Sink lifecycle:
+ *   - begin() failure marks the pipeline Failed, records it, and suppresses
+ *     drawFrame(). It does not retry automatically.
+ *   - The owner may call retrySinkBegin() to return to NotStarted, after which
+ *     the next render() attempts begin() again.
+ *
+ * render() is non-blocking and never touches hardware by itself.
+ */
+class DisplayPipeline {
+public:
+    enum class SinkState : std::uint8_t {
+        NotStarted = 0,
+        Running,
+        Failed,
+    };
+
+    explicit DisplayPipeline(DisplaySink& sink);
+
+    StateAdapter& adapter() { return adapter_; }
+    AnimationController& animation() { return animation_; }
+    DisplaySink& sink() { return *sink_; }
+
+    /**
+     * Replaces the output sink. Ends the previous sink if it was running and
+     * resets the sink lifecycle so the new sink gets begin(). Returns false
+     * when the same sink is supplied.
+     */
+    bool setSink(DisplaySink& sink);
+
+    bool render(std::uint32_t nowMs);
+
+    /** Allows a new begin() attempt after a failure. */
+    bool retrySinkBegin();
+
+    SinkState sinkState() const { return sinkState_; }
+    int framesRendered() const { return framesRendered_; }
+    int sinkFailures() const { return sinkFailures_; }
+    int initFailures() const { return initFailures_; }
+
+private:
+    StateAdapter adapter_;
+    AnimationController animation_;
+    DisplaySink* sink_;  // replaceable; see setSink()
+    SinkState sinkState_ = SinkState::NotStarted;
+    int framesRendered_ = 0;
+    int sinkFailures_ = 0;
+    int initFailures_ = 0;
+};
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/start_gate.h b/main/musse_display/include/musse/display/start_gate.h
new file mode 100644
index 0000000..aa787d0
--- /dev/null
+++ b/main/musse_display/include/musse/display/start_gate.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace musse::display {
+
+/**
+ * One-shot start gate with explicit failure/retry semantics.
+ *
+ * States:
+ *   NotStarted -> Starting -> Running
+ *                        \-> Failed -> Starting (retry allowed)
+ *
+ * Concurrent callers: exactly one CAS winner moves to Starting; other callers
+ * return false until the winner marks Running or Failed.
+ */
+class StartGate {
+public:
+    enum class State : int {
+        NotStarted = 0,
+        Starting,
+        Running,
+        Failed,
+    };
+
+    bool beginStart() {
+        State expected = state_.load(std::memory_order_acquire);
+        while (expected == State::NotStarted || expected == State::Failed) {
+            if (state_.compare_exchange_weak(expected, State::Starting,
+                                             std::memory_order_acq_rel,
+                                             std::memory_order_acquire)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void markRunning() { state_.store(State::Running, std::memory_order_release); }
+    void markFailed() { state_.store(State::Failed, std::memory_order_release); }
+
+    State state() const { return state_.load(std::memory_order_acquire); }
+    bool running() const { return state() == State::Running; }
+
+private:
+    std::atomic<State> state_{State::NotStarted};
+};
+
+}  // namespace musse::display
diff --git a/main/musse_display/include/musse/display/state_adapter.h b/main/musse_display/include/musse/display/state_adapter.h
new file mode 100644
index 0000000..f8ceef1
--- /dev/null
+++ b/main/musse_display/include/musse/display/state_adapter.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <cstdint>
+
+#include "musse/display/emotion.h"
+
+namespace musse::display {
+
+/**
+ * MuSSE-local mirror of the upstream device states.
+ *
+ * Names intentionally match xiaozhi v2.5.2 `main/device_state.h`, but this
+ * enum is owned by MuSSE so the core library can be unit-tested on Windows
+ * without pulling in ESP-IDF headers.
+ *
+ * There is no Thinking state upstream. Thinking is a separate explicit
+ * business event (see setThinking) and is never inferred from Connecting.
+ */
+enum class DeviceState : std::uint8_t {
+    Unknown = 0,
+    Starting,
+    WifiConfiguring,
+    Idle,
+    Connecting,
+    Listening,
+    Speaking,
+    Notifying,
+    Upgrading,
+    Activating,
+    AudioTesting,
+    FatalError,
+};
+
+const char* deviceStateName(DeviceState state);
+
+/**
+ * Converts upstream AI emotion names to MuSSE expressions.
+ *
+ * Negative AI emotions (sad/angry/crying/...) map to Idle, NOT Error: they
+ * are conversational emotions, not device failures. Unknown names return
+ * false and callers must not change the current display.
+ */
+bool mapUpstreamEmotion(const char* name, Emotion& out);
+
+/** True for Alert icon names that mean a device/business error. */
+bool isAlertErrorEmotion(const char* name);
+/** True for Alert icon names that are progress notices, not errors. */
+bool isAlertProgressEmotion(const char* name);
+
+/**
+ * Resolves the expression to display with this priority:
+ *   1. sticky device/business error (setError / onAlertEmotion)
+ *   2. explicit Thinking event (setThinking)
+ *   3. temporary AI emotion (onEmotionName, TTL)
+ *   4. device state mapping
+ *
+ * Unknown/empty/null emotion names are ignored and never overwrite a valid
+ * state. Connecting maps to Idle, never Thinking.
+ */
+class StateAdapter {
+public:
+    static constexpr std::uint32_t kDefaultEmotionTtlMs = 3000;
+
+    explicit StateAdapter(std::uint32_t emotionTtlMs = kDefaultEmotionTtlMs);
+
+    void onDeviceState(DeviceState state);
+    DeviceState deviceState() const { return deviceState_; }
+
+    /**
+     * AI/LLM emotion. Known names become a temporary expression with TTL.
+     * Returns false and leaves all state unchanged for unknown/empty/null.
+     */
+    bool onEmotionName(const char* name, std::uint32_t nowMs);
+
+    /**
+     * Upstream Alert() emotion (device/business status, not AI mood).
+     * warning/cancel/cloud_off/error -> sticky Error.
+     * download/cloud_download/link   -> progress notice, no mood override.
+     * other names                    -> AI mapping.
+     */
+    bool onAlertEmotion(const char* name, std::uint32_t nowMs);
+
+    /** DismissAlert() recovery: clears sticky error and temporary emotion. */
+    void onAlertDismissed();
+
+    void clearTemporaryEmotion();
+
+    void setThinking(bool active, std::uint32_t nowMs);
+    bool thinking() const { return thinking_; }
+
+    void setError(bool active);
+    /** Timed device/business error; auto-clears after durationMs. */
+    void setTimedError(std::uint32_t nowMs, std::uint32_t durationMs);
+    bool error() const { return error_; }
+
+    void tick(std::uint32_t nowMs);
+    Emotion resolve(std::uint32_t nowMs);
+
+    std::uint32_t emotionTtlMs() const { return emotionTtlMs_; }
+
+private:
+    bool temporaryEmotionActive(std::uint32_t nowMs) const;
+
+    DeviceState deviceState_ = DeviceState::Unknown;
+    bool thinking_ = false;
+    bool error_ = false;
+    bool errorTimed_ = false;
+    std::uint32_t errorUntilMs_ = 0;
+    bool hasTemporaryEmotion_ = false;
+    Emotion temporaryEmotion_ = Emotion::Idle;
+    std::uint32_t temporaryEmotionUntilMs_ = 0;
+    std::uint32_t emotionTtlMs_;
+};
+
+/** Pure device-state to expression mapping (public for tests). */
+Emotion emotionForDeviceState(DeviceState state);
+
+}  // namespace musse::display
diff --git a/main/musse_display/musse_display_service.cc b/main/musse_display/musse_display_service.cc
new file mode 100644
index 0000000..1b657c9
--- /dev/null
+++ b/main/musse_display/musse_display_service.cc
@@ -0,0 +1,129 @@
+#include "musse_display_service.h"
+
+#include <cstring>
+
+#include <esp_log.h>
+#include <esp_timer.h>
+
+namespace musse::integration {
+namespace {
+
+constexpr const char* kTag = "MusseDisplay";
+constexpr int kFrameIntervalMs = 50;  // 20 fps software loop
+// ESP-IDF xTaskCreate() takes the stack depth in BYTES.
+constexpr UBaseType_t kTaskStackBytes = 4096;
+constexpr UBaseType_t kTaskPriority = 3;
+
+std::uint32_t nowMs() {
+    return static_cast<std::uint32_t>(esp_timer_get_time() / 1000);
+}
+
+}  // namespace
+
+MusseDisplayService& MusseDisplayService::GetInstance() {
+    static MusseDisplayService instance;
+    return instance;
+}
+
+bool MusseDisplayService::Start() {
+    if (!gate_.beginStart()) {
+        // Already starting/running, or another caller won the race.
+        return gate_.running();
+    }
+
+    const BaseType_t created = xTaskCreate(
+        TaskEntry, "musse_display", kTaskStackBytes, this, kTaskPriority, nullptr);
+    if (created != pdPASS) {
+        gate_.markFailed();
+        ESP_LOGE(kTag, "failed to create render task; call Start() again to retry");
+        return false;
+    }
+
+    gate_.markRunning();
+    ESP_LOGI(kTag, "engine started; sink=Noop (no hardware output)");
+    return true;
+}
+
+bool MusseDisplayService::SetSink(display::DisplaySink& sink) {
+    if (gate_.running() && enabled()) {
+        // Avoid swapping the sink while the render task is using it.
+        return false;
+    }
+    return pipeline_.setSink(sink);
+}
+
+void MusseDisplayService::OnDeviceState(DeviceState state) {
+    display::Event event;
+    event.type = display::EventType::DeviceState;
+    event.value = static_cast<std::uint8_t>(state);
+    event.timeMs = nowMs();
+    enqueue(event);
+}
+
+void MusseDisplayService::OnEmotion(const char* emotion) {
+    enqueueEmotion(display::EventType::Emotion, emotion, nowMs());
+}
+
+void MusseDisplayService::OnAlertEmotion(const char* emotion) {
+    const display::EventType type =
+        display::isAlertErrorEmotion(emotion)
+            ? display::EventType::AlertEmotion
+            : display::EventType::AlertProgress;
+    enqueueEmotion(type, emotion, nowMs());
+}
+
+void MusseDisplayService::OnAlertDismissed() {
+    display::Event event;
+    event.type = display::EventType::AlertDismiss;
+    event.timeMs = nowMs();
+    enqueue(event);
+}
+
+void MusseDisplayService::SetThinking(bool active) {
+    display::Event event;
+    event.type = display::EventType::Thinking;
+    event.value = active ? 1 : 0;
+    event.timeMs = nowMs();
+    enqueue(event);
+}
+
+void MusseDisplayService::enqueueEmotion(display::EventType type, const char* text,
+                                         std::uint32_t timeMs) {
+    display::Event event;
+    event.type = type;
+    event.timeMs = timeMs;
+    if (text != nullptr) {
+        std::strncpy(event.text, text, display::kEventTextCapacity - 1);
+    }
+    enqueue(event);
+}
+
+void MusseDisplayService::enqueue(display::Event event) {
+    // Bounded, critical-section protected, never blocks on I/O, never allocates.
+    // Critical events go to protected slots; emotions may be dropped when full.
+    queue_.push(event);
+}
+
+void MusseDisplayService::TaskEntry(void* arg) {
+    static_cast<MusseDisplayService*>(arg)->Run();
+}
+
+void MusseDisplayService::Run() {
+    for (;;) {
+        display::Event event;
+        // Drain in sequence order so state/emotion/alert ordering is preserved.
+        while (queue_.pop(event)) {
+            display::applyEvent(pipeline_.adapter(), event);
+        }
+
+        if (enabled_.load(std::memory_order_relaxed)) {
+            pipeline_.render(nowMs());
+            frames_.store(pipeline_.framesRendered(), std::memory_order_relaxed);
+            failures_.store(pipeline_.sinkFailures(), std::memory_order_relaxed);
+        }
+
+        vTaskDelay(pdMS_TO_TICKS(kFrameIntervalMs));
+    }
+}
+
+}  // namespace musse::integration
diff --git a/main/musse_display/musse_display_service.h b/main/musse_display/musse_display_service.h
new file mode 100644
index 0000000..945b337
--- /dev/null
+++ b/main/musse_display/musse_display_service.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "device_state.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos_event_lock.h"
+#include "musse/display/event_dispatch.h"
+#include "musse/display/event_queue.h"
+#include "musse/display/noop_sink.h"
+#include "musse/display/pipeline.h"
+#include "musse/display/start_gate.h"
+
+namespace musse::integration {
+
+/**
+ * Firmware bridge between real xiaozhi events and the MuSSE pipeline.
+ *
+ * - Event callbacks only enqueue a fixed-size event (no rendering, no heap).
+ * - Critical events (state, Thinking, Alert error, AlertDismiss) use dedicated
+ *   slots and can never be dropped by an emotion flood; ordinary emotions use
+ *   a bounded FIFO and may be dropped when full.
+ * - One low-priority task drains events in sequence order, applies them with
+ *   the same applyEvent() used by host tests, and renders into a sink.
+ * - Start() has explicit failure/retry semantics via StartGate.
+ * - No GPIO / I2C / RMT access.
+ */
+class MusseDisplayService {
+public:
+    static MusseDisplayService& GetInstance();
+
+    /** Returns false if task creation fails; a later call can retry. */
+    bool Start();
+
+    void SetEnabled(bool enabled) { enabled_.store(enabled, std::memory_order_relaxed); }
+    bool enabled() const { return enabled_.load(std::memory_order_relaxed); }
+
+    /**
+     * Replace the output sink. Intended before Start() or while disabled;
+     * returns false if the task is running with rendering enabled.
+     */
+    bool SetSink(display::DisplaySink& sink);
+
+    void OnDeviceState(DeviceState state);
+    void OnEmotion(const char* emotion);
+    void OnAlertEmotion(const char* emotion);
+    void OnAlertDismissed();
+    void SetThinking(bool active);
+
+    int framesRendered() const { return frames_.load(std::memory_order_relaxed); }
+    int sinkFailures() const { return failures_.load(std::memory_order_relaxed); }
+    std::uint32_t droppedEmotions() const { return queue_.dropped(); }
+    std::uint32_t mergedCriticalEvents() const { return queue_.merged(); }
+    bool running() const { return gate_.running(); }
+
+private:
+    MusseDisplayService() = default;
+
+    static void TaskEntry(void* arg);
+    void Run();
+    void enqueueEmotion(display::EventType type, const char* text, std::uint32_t nowMs);
+    void enqueue(display::Event event);
+
+    display::NoopSink sink_;
+    display::DisplayPipeline pipeline_{sink_};
+    FirmwareEventQueue queue_;
+    display::StartGate gate_;
+    std::atomic<bool> enabled_{true};
+    std::atomic<int> frames_{0};
+    std::atomic<int> failures_{0};
+};
+
+}  // namespace musse::integration
diff --git a/main/musse_display/src/animation_controller.cpp b/main/musse_display/src/animation_controller.cpp

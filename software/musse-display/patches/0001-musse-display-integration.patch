diff --git a/main/musse_display/freertos_event_lock.h b/main/musse_display/freertos_event_lock.h
new file mode 100644
index 0000000..37b6ad5
--- /dev/null
+++ b/main/musse_display/freertos_event_lock.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include "freertos/FreeRTOS.h"
+#include "musse/display/event_queue.h"
+
+namespace musse::integration {
+
+/**
+ * FreeRTOS critical-section lock for the event queue.
+ *
+ * Only task-context producers/consumers are supported. The critical section
+ * is extremely short (array copy + index update); it never renders, logs or
+ * performs I/O. ISR producers would require portENTER_CRITICAL_ISR and a
+ * separately reviewed queue, which this firmware does not use.
+ */
+struct FreeRtosCriticalLock {
+    portMUX_TYPE mux = portMUX_INITIALIZER_UNLOCKED;
+
+    void lock() { portENTER_CRITICAL(&mux); }
+    void unlock() { portEXIT_CRITICAL(&mux); }
+};
+
+using FirmwareEventQueue = musse::display::BasicEventQueue<FreeRtosCriticalLock>;
+
+}  // namespace musse::integration

+#include "musse/display/animation_controller.h"
+
+namespace musse::display {
+
+void AnimationController::setEmotion(Emotion emotion, std::uint32_t nowMs) {
+    if (emotion != emotion_) {
+        emotion_ = emotion;
+        startMs_ = nowMs;
+    }
+}
+
+FrameBuffer AnimationController::frame(std::uint32_t nowMs) const {
+    return renderer_.render(emotion_, elapsed(nowMs));
+}
+
+std::uint32_t AnimationController::elapsed(std::uint32_t nowMs) const {
+    return nowMs - startMs_;  // unsigned arithmetic also handles wraparound
+}
+
+}  // namespace musse::display
diff --git a/main/musse_display/src/display_sink.cpp b/main/musse_display/src/display_sink.cpp
new file mode 100644
index 0000000..9fa950b
--- /dev/null
+++ b/main/musse_display/src/display_sink.cpp
@@ -0,0 +1,72 @@
+#include "musse/display/display_sink.h"
+
+#include <cstring>
+
+namespace musse::display {
+
+bool RgbSink::drawFrame(const FrameBuffer& frame) {
+    lastFrame_ = frame;
+    ++frameCount_;
+    return true;
+}
+
+MonochromeSink::MonochromeSink(const PixelMapper* mapper, int threshold)
+    : mapper_(mapper), threshold_(threshold) {
+    std::memset(bits_, 0, sizeof(bits_));
+}
+
+bool MonochromeSink::drawFrame(const FrameBuffer& frame) {
+    std::memset(bits_, 0, sizeof(bits_));
+    for (int y = 0; y < FrameBuffer::kHeight; ++y) {
+        for (int x = 0; x < FrameBuffer::kWidth; ++x) {
+            const Rgb c = frame.pixel(x, y);
+            const int luma = (c.r * 299 + c.g * 587 + c.b * 114) / 1000;
+            if (luma < threshold_) {
+                continue;
+            }
+            const int idx = mapper_ != nullptr ? mapper_->index(x, y)
+                                               : y * FrameBuffer::kWidth + x;
+            if (idx < 0 || idx >= static_cast<int>(FrameBuffer::kPixelCount)) {
+                return false;  // mapper produced an invalid index
+            }
+            bits_[idx / 8] |= static_cast<std::uint8_t>(1u << (idx % 8));
+        }
+    }
+    ++frameCount_;
+    return true;
+}
+
+bool MonochromeSink::bit(int x, int y) const {
+    if (x < 0 || y < 0 || x >= FrameBuffer::kWidth || y >= FrameBuffer::kHeight) {
+        return false;
+    }
+    const int idx = mapper_ != nullptr ? mapper_->index(x, y)
+                                       : y * FrameBuffer::kWidth + x;
+    if (idx < 0 || idx >= static_cast<int>(FrameBuffer::kPixelCount)) {
+        return false;
+    }
+    return (bits_[idx / 8] & static_cast<std::uint8_t>(1u << (idx % 8))) != 0;
+}
+
+bool MockSink::begin() {
+    ++beginCount_;
+    if (failBegin_) {
+        ++beginFailures_;
+        return false;
+    }
+    return true;
+}
+
+bool MockSink::drawFrame(const FrameBuffer& frame) {
+    ++frameCount_;
+    if (failAlways_ || frameCount_ == failOnFrame_) {
+        ++failureCount_;
+        return false;
+    }
+    lastFrame_ = frame;
+    return true;
+}
+
+void MockSink::end() { ++endCount_; }
+
+}  // namespace musse::display
diff --git a/main/musse_display/src/emotion.cpp b/main/musse_display/src/emotion.cpp
new file mode 100644
index 0000000..524f5c1
--- /dev/null
+++ b/main/musse_display/src/emotion.cpp
@@ -0,0 +1,30 @@
+#include "musse/display/emotion.h"
+
+#include <cstring>
+
+namespace musse::display {
+
+const char* emotionName(Emotion emotion) {
+    switch (emotion) {
+        case Emotion::Idle: return "Idle";
+        case Emotion::Listening: return "Listening";
+        case Emotion::Thinking: return "Thinking";
+        case Emotion::Speaking: return "Speaking";
+        case Emotion::Error: return "Error";
+    }
+    return "Idle";
+}
+
+bool parseEmotion(const char* name, Emotion& out) {
+    if (name == nullptr) {
+        return false;
+    }
+    if (std::strcmp(name, "Idle") == 0) { out = Emotion::Idle; return true; }
+    if (std::strcmp(name, "Listening") == 0) { out = Emotion::Listening; return true; }
+    if (std::strcmp(name, "Thinking") == 0) { out = Emotion::Thinking; return true; }
+    if (std::strcmp(name, "Speaking") == 0) { out = Emotion::Speaking; return true; }
+    if (std::strcmp(name, "Error") == 0) { out = Emotion::Error; return true; }
+    return false;
+}
+
+}  // namespace musse::display
diff --git a/main/musse_display/src/emotion_renderer.cpp b/main/musse_display/src/emotion_renderer.cpp
new file mode 100644
index 0000000..2fb78f8
--- /dev/null
+++ b/main/musse_display/src/emotion_renderer.cpp
@@ -0,0 +1,89 @@
+#include "musse/display/emotion_renderer.h"
+
+namespace musse::display {
+namespace {
+
+std::uint32_t phase(std::uint32_t timeMs, std::uint32_t periodMs) {
+    return periodMs == 0 ? 0 : (timeMs % periodMs);
+}
+
+void eyes(FrameBuffer& frame, int lx, int ly, int lw, int lh,
+          int rx, int ry, int rw, int rh, Rgb color) {
+    frame.fillRect(lx, ly, lw, lh, color);
+    frame.fillRect(rx, ry, rw, rh, color);
+}
+
+}  // namespace
+
+FrameBuffer EmotionRenderer::render(Emotion emotion, std::uint32_t timeMs) const {
+    FrameBuffer frame;
+
+    switch (emotion) {
+        case Emotion::Idle: {
+            const Rgb c = color::Cyan;
+            const bool blinking = phase(timeMs, 3000) < 160;
+            if (blinking) {
+                eyes(frame, 3, 7, 3, 1, 10, 7, 3, 1, c);
+            } else {
+                eyes(frame, 3, 5, 3, 3, 10, 5, 3, 3, c);
+            }
+            frame.fillRect(6, 11, 4, 1, c);  // neutral mouth
+            break;
+        }
+
+        case Emotion::Listening: {
+            const Rgb c = color::Green;
+            eyes(frame, 3, 4, 3, 4, 10, 4, 3, 4, c);
+            frame.fillRect(7, 10, 2, 2, c);  // small mouth
+            const std::uint32_t p = phase(timeMs, 1200);
+            const int level = p < 600 ? static_cast<int>(p * 5 / 600)
+                                      : static_cast<int>((1200 - p) * 5 / 600);
+            frame.fillRect(1, 8 - level, 1, 2 + level, c);
+            frame.fillRect(14, 8 - level, 1, 2 + level, c);
+            break;
+        }
+
+        case Emotion::Thinking: {
+            const Rgb c = color::Amber;
+            eyes(frame, 3, 6, 2, 2, 11, 4, 2, 2, c);  // looking up/aside
+            frame.fillRect(8, 11, 1, 1, c);            // small mouth
+            const int active = static_cast<int>(phase(timeMs, 1500) / 500);
+            for (int i = 0; i < 3; ++i) {
+                if (i == active) {
+                    frame.fillRect(5 + i * 3, 1, 2, 2, c);
+                } else {
+                    frame.fillRect(5 + i * 3, 2, 1, 1, c);
+                }
+            }
+            break;
+        }
+
+        case Emotion::Speaking: {
+            const Rgb c = color::Orange;
+            eyes(frame, 3, 5, 2, 3, 11, 5, 2, 3, c);
+            const int mouthHeight = phase(timeMs, 250) < 125 ? 3 : 1;
+            frame.fillRect(5, 10, 6, mouthHeight, c);
+            break;
+        }
+
+        case Emotion::Error: {
+            const Rgb c = color::Red;
+            frame.drawLine(3, 5, 5, 7, c);
+            frame.drawLine(3, 7, 5, 5, c);
+            frame.drawLine(10, 5, 12, 7, c);
+            frame.drawLine(10, 7, 12, 5, c);
+            frame.setPixel(5, 12, c);
+            frame.setPixel(6, 11, c);
+            frame.setPixel(7, 11, c);
+            frame.setPixel(8, 11, c);
+            frame.setPixel(9, 12, c);
+            const Rgb border = phase(timeMs, 600) < 300 ? color::Red : color::DimRed;
+            frame.drawRect(0, 0, FrameBuffer::kWidth, FrameBuffer::kHeight, border);
+            break;
+        }
+    }
+
+    return frame;
+}
+
+}  // namespace musse::display
diff --git a/main/musse_display/src/frame_buffer.cpp b/main/musse_display/src/frame_buffer.cpp
